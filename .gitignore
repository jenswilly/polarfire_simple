# ---- Libero project (polarfire_simple/) : keep config, drop build output ----
# Synthesis, place & route, bitstreams and programming files (all regenerable)
polarfire_simple/synthesis/
polarfire_simple/designer/*
# ...except the eNVM (Boot Mode 1) client config from Configure Design Initialization Data and Memories
!polarfire_simple/designer/TOP/
polarfire_simple/designer/TOP/*
!polarfire_simple/designer/TOP/ENVM.cfg
# ...and a placeholder so designer/impl1/ exists. Without it Libero creates a new revision (Impl2, ...) on open.
!polarfire_simple/designer/impl1/
polarfire_simple/designer/impl1/*
!polarfire_simple/designer/impl1/simulation/
polarfire_simple/designer/impl1/simulation/*
!polarfire_simple/designer/impl1/simulation/.gitkeep
polarfire_simple/tooldata/
polarfire_simple/simulation/modelsim.ini
# Libero Simulate output (compiled libraries, generated run.do, waveforms, BFM vectors)
polarfire_simple/simulation/presynth/
polarfire_simple/simulation/postsynth/
polarfire_simple/simulation/postlayout/
polarfire_simple/simulation/run.do
polarfire_simple/simulation/*.wlf
polarfire_simple/simulation/*.vec
polarfire_simple/simulation/transcript
polarfire_simple/stimulus/
polarfire_simple/viewdraw/

# Don't what this autogenerated Libero file is:
kk56c81a5ef0f7

# Logs and lock/backup files
*.log
*.msg
*.lock
*.bak
*.sav
*~
polarfire_simple/constraint/*_errors.log
polarfire_simple/constraint/run_*_sdc_check.tcl

# QuestaSim output from sim/run_tb.sh (work library, transcript, waveforms)
sim/out/

# I/O Editor exports written next to the linked constraint file
constraints/pre/

# ---- SoftConsole / Eclipse ----
# Workspace metadata is per-machine (shared launch configs live in the project)
softconsole/.metadata/
# Build output folders are named after the build configuration
softconsole/*/*-Debug/
softconsole/*/*-Release/
# Generated from the MSS XML by the pre-build step
softconsole/*/src/boards/*/fpga_design_config/
softconsole/*/.settings/

# ---- Misc ----
.DS_Store

# ---- RTEMS ----
# Generated from rtems/dts/mpfs-discovery-kit.dts by rtems/dts/build_dtb.sh
rtems/dts/mpfs-discovery-kit-dtb.h
# HSS build output (hss/build_hss.sh, hss/make_envm_hex.sh)
hss/build/
# RTEMS application build output
rtems/led_test/build/
