# ---- Libero project (polarfire_simple/) : keep config, drop build output ----
# Synthesis, place & route, bitstreams and programming files (all regenerable)
polarfire_simple/synthesis/
polarfire_simple/designer/*
# ...except the eNVM (Boot Mode 1) client config from Configure Design Initialization Data and Memories
!polarfire_simple/designer/TOP/
polarfire_simple/designer/TOP/*
!polarfire_simple/designer/TOP/ENVM.cfg
polarfire_simple/tooldata/
polarfire_simple/simulation/modelsim.ini
polarfire_simple/stimulus/

polarfire_simple/viewdraw/

# Logs and lock/backup files
*.log
*.msg
*.lock
*.bak
*.sav
*~
polarfire_simple/constraint/*_errors.log

# I/O Editor exports written next to the linked constraint file
constraints/pre/

# ---- SoftConsole / Eclipse ----
# Workspace metadata is per-machine (shared launch configs live in the project)
softconsole/.metadata/
# Build output folders are named after the build configuration
softconsole/*/*-Debug/
softconsole/*/*-Release/
# Generated from the MSS XML by the pre-build step
softconsole/*/src/boards/*/fpga_design_config/
softconsole/*/.settings/

# ---- Misc ----
.DS_Store
