<mxfile host="drawio" version="24.7.17">
  <diagram id="qspi_controller" name="QSPI controller">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1580" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;QSPI MRAM controller&lt;/b&gt; (see README.md)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="600" height="30" as="geometry" />
        </mxCell>

        <!-- Clocking -->
        <mxCell id="refclk" value="REF_CLK_50MHz&lt;br&gt;R18" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.15;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="clkint" value="&lt;b&gt;CLKINT&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="200" y="90" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ccc" value="&lt;b&gt;PF_CCC_C0&lt;/b&gt;&lt;br&gt;VCO 4000 MHz (was 5000)&lt;br&gt;OUT0 ÷8 → 125 MHz&lt;br&gt;OUT1 ÷10 → 100 MHz (new)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="340" y="70" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="fabric" value="&lt;b&gt;Existing fabric logic&lt;/b&gt;&lt;br&gt;FIC0 ACLK, spi_tx_path, … (125 MHz)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="640" y="50" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="rst1" value="&lt;b&gt;CORERESET_1&lt;/b&gt; (CORERESET_PF)&lt;br&gt;CLK = clk_ctrl&lt;br&gt;PLL_LOCK, INIT_DONE as CORERESET_0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="640" y="130" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e_ref_int" value="50 MHz" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="refclk" target="clkint">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_int_ccc" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.556;entryDx=0;entryDy=0;" edge="1" parent="1" source="clkint" target="ccc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_ccc_fab" value="OUT0 125 MHz" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=1;exitY=0.111;exitDx=0;exitDy=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="ccc" target="fabric">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_ccc_rst" value="OUT1 100 MHz&lt;br&gt;PLL_LOCK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=1;exitY=0.889;exitDx=0;exitDy=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="ccc" target="rst1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- qspi_board wrapper (HDL+ core in TOP); drawn first so it is behind its blocks -->
        <mxCell id="board" value="&lt;b&gt;qspi_board&lt;/b&gt; (HDL+ core in TOP, all on clk_ctrl)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;fontColor=#3c5d8f;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="1260" height="600" as="geometry" />
        </mxCell>
        <mxCell id="e_clk_board" value="clk_ctrl (OUT1, 100 MHz)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1;entryX=0.317;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ccc" target="board">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_rst_board" value="reset_n" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1;entryX=0.571;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rst1" target="board">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- qspi_mram_ctrl wrapper -->
        <mxCell id="ctrl" value="&lt;b&gt;qspi_mram_ctrl&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;fontColor=#4d7c3a;" vertex="1" parent="1">
          <mxGeometry x="420" y="280" width="640" height="520" as="geometry" />
        </mxCell>

        <!-- BIST -->
        <mxCell id="bist" value="&lt;b&gt;qspi_bist&lt;/b&gt;&lt;br&gt;&lt;br&gt;after init_done:&lt;br&gt;write counter pattern once,&lt;br&gt;then read back and&lt;br&gt;compare once&lt;br&gt;(LOOP_ROUNDS: until reset)&lt;br&gt;&lt;br&gt;CALIBRATE: retry init and&lt;br&gt;sweep SAMPLE_DLY 1–4,&lt;br&gt;pick the window centre" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="70" y="300" width="200" height="320" as="geometry" />
        </mxCell>

        <!-- Command sources -->
        <mxCell id="read" value="&lt;b&gt;qspi_read_ctrl&lt;/b&gt;&lt;br&gt;EBh (1-4-4) reads&lt;br&gt;starts when rx_space ≥ in_flight + len&lt;br&gt;tlast on last byte" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="460" y="310" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="write" value="&lt;b&gt;qspi_write&lt;/b&gt;&lt;br&gt;WREN + write per device&lt;br&gt;(W25Q: erase, 256 B pages, BUSY polling)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="460" y="430" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="init" value="&lt;b&gt;qspi_init&lt;/b&gt;&lt;br&gt;power-up wait, reset,&lt;br&gt;JEDEC ID, configure,&lt;br&gt;verify, init_done" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="460" y="550" width="180" height="90" as="geometry" />
        </mxCell>

        <!-- Transaction engine and PHY -->
        <mxCell id="xact" value="&lt;b&gt;qspi_xact&lt;/b&gt;&lt;br&gt;&lt;br&gt;command →&lt;br&gt;phase descriptors&lt;br&gt;&lt;br&gt;opcode, address,&lt;br&gt;mode byte, latency,&lt;br&gt;data&lt;br&gt;&lt;br&gt;1-1-1 / 1-1-4 / 1-4-4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="720" y="310" width="140" height="330" as="geometry" />
        </mxCell>
        <mxCell id="phy" value="&lt;b&gt;qspi_phy&lt;/b&gt;&lt;br&gt;&lt;br&gt;SCLK = clk_ctrl /&lt;br&gt;(2 × SCLK_DIV)&lt;br&gt;&lt;br&gt;CS#, IO out/OE,&lt;br&gt;OE turnaround&lt;br&gt;&lt;br&gt;samples IO&lt;br&gt;SAMPLE_DLY cycles&lt;br&gt;after launch edge&lt;br&gt;&lt;br&gt;min. CS# high time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="900" y="310" width="140" height="330" as="geometry" />
        </mxCell>

        <mxCell id="pkg" value="&lt;b&gt;qspi_pkg&lt;/b&gt; (used by all qspi blocks): device_t, opcodes, address width, mode byte, latency, timing in ns, ns → cycles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="730" width="580" height="40" as="geometry" />
        </mxCell>

        <!-- IO buffers -->
        <mxCell id="iobuf" value="&lt;b&gt;Tristate IO buffers&lt;/b&gt;&lt;br&gt;inout io(3:0)&lt;br&gt;io(7:4), CS2#, CLK2&lt;br&gt;only if DIE2_PRESENT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1100" y="380" width="170" height="190" as="geometry" />
        </mxCell>

        <!-- Pins and device -->
        <mxCell id="qpins" value="QSPI_SCLK G18 (pin 11)&lt;br&gt;QSPI_CS_N F21 (pin 13)&lt;br&gt;QSPI_IO0..3 F20, E21, F19, A19&lt;br&gt;(pins 15, 16, 18, 22)&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;RPi header, Bank1, LVCMOS33,&lt;br&gt;pull-ups on CS#, IO2, IO3&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1360" y="420" width="180" height="110" as="geometry" />
        </mxCell>
        <mxCell id="dev" value="&lt;b&gt;W25Q128JV breakout&lt;/b&gt;&lt;br&gt;(prototype, single die)&lt;br&gt;&lt;br&gt;&lt;b&gt;AS308G208&lt;/b&gt;&lt;br&gt;(later, dual die)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1360" y="600" width="180" height="100" as="geometry" />
        </mxCell>

        <mxCell id="ledpins" value="LED5 (pass) AA18&lt;br&gt;LED6 (fail) V16" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="880" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- BIST connections -->
        <mxCell id="e_bist_read" value="read request AXIS {len, addr}&lt;br&gt;rx_space (credit)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=1;exitY=0.07;exitDx=0;exitDy=0;entryX=0;entryY=0.142;entryDx=0;entryDy=0;" edge="1" parent="1" source="bist" target="read">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_read_bist" value="m_axis 8 b + tlast&lt;br&gt;req_err" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0;exitY=0.55;exitDx=0;exitDy=0;entryX=1;entryY=0.186;entryDx=0;entryDy=0;" edge="1" parent="1" source="read" target="bist">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_bist_write" value="write request AXIS&lt;br&gt;{len, addr} + data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=1;exitY=0.547;exitDx=0;exitDy=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="bist" target="write">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_init_bist" value="init_done, init_err&lt;br&gt;(init_restart ←)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0;exitY=0.5;entryX=1;entryY=0.922;entryDx=0;entryDy=0;" edge="1" parent="1" source="init" target="bist">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_bist_phy" value="sample_dly_ovr (valid + value)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="bist" target="phy">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="210" y="690" />
              <mxPoint x="970" y="690" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_bist_led" value="pass / fail" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="bist" target="ledpins">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="130" y="860" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Command sources -> xact -->
        <mxCell id="e_read_xact" value="cmd ↔ RX bytes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;startArrow=classic;startFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.136;entryDx=0;entryDy=0;" edge="1" parent="1" source="read" target="xact">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_write_xact" value="cmd + TX bytes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="write" target="xact">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_init_xact" value="cmd ↔ RX bytes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;startArrow=classic;startFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.864;entryDx=0;entryDy=0;" edge="1" parent="1" source="init" target="xact">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- xact <-> phy -->
        <mxCell id="e_xact_phy" value="phase&lt;br&gt;descriptors" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="xact" target="phy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_phy_xact" value="RX words&lt;br&gt;{die2_nib,&lt;br&gt;die1_nib}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0;exitY=0.65;exitDx=0;exitDy=0;entryX=1;entryY=0.65;entryDx=0;entryDy=0;" edge="1" parent="1" source="phy" target="xact">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- phy <-> IO buffers -->
        <mxCell id="e_phy_buf" value="sclk(1:0), cs_n(1:0)&lt;br&gt;io_o(7:0), io_oe(7:0)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=1;exitY=0.364;exitDx=0;exitDy=0;entryX=0;entryY=0.263;entryDx=0;entryDy=0;" edge="1" parent="1" source="phy" target="iobuf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_buf_phy" value="io_i(7:0)&lt;br&gt;(7:4 = 0000 if&lt;br&gt;single die)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0;exitY=0.737;exitDx=0;exitDy=0;entryX=1;entryY=0.636;entryDx=0;entryDy=0;" edge="1" parent="1" source="iobuf" target="phy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- IO buffers <-> pins <-> device -->
        <mxCell id="e_buf_pins" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=classic;startFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="iobuf" target="qpins">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_pins_dev" value="short wires" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;startArrow=classic;startFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="qpins" target="dev">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="leg_done" value="exists" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="890" width="90" height="30" as="geometry" />
        </mxCell>
        <mxCell id="leg_chg" value="exists, changed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="890" width="100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="leg_todo" value="planned" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="510" y="890" width="90" height="30" as="geometry" />
        </mxCell>
        <mxCell id="leg_ext" value="external" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="610" y="890" width="90" height="30" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Single clock domain: every qspi block runs on clk_ctrl (100 MHz) with reset_n from CORERESET_1. Only LED5/LED6 leave the domain, so there is no CDC logic. qspi_board generics (integers for HDL+): DEVICE_SEL, CLK_HZ, SCLK_DIV, SAMPLE_DLY, CALIBRATE, NBLK, BLK_LEN; single die only. I/O registers (constraints/qspi_ioreg.ndc): SCLK/CS# output and IO3:0 input registers sit in the I/O cells. RESET# (AS308G208) is not a qspi_board port: tie it high on the board until the dual-die wrapper exists (README.md). init, read and write share qspi_xact through an arbiter (init first, then read/write take turns; the owner only changes while qspi_xact is idle)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="730" y="870" width="810" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
