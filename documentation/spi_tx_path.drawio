<mxfile host="drawio" version="24.7.17">
  <diagram id="spi_tx_path" name="SPI TX path">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title and notes -->
        <mxCell id="title" value="&lt;b&gt;SPI TX path&lt;/b&gt; (all blocks on the 125 MHz fabric clock)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="600" height="30" as="geometry" />
        </mxCell>

        <!-- spi_tx_path wrapper (drawn first so it is behind its blocks) -->
        <mxCell id="txpath" value="&lt;b&gt;spi_tx_path&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;fontColor=#4d7c3a;" vertex="1" parent="1">
          <mxGeometry x="520" y="140" width="680" height="150" as="geometry" />
        </mxCell>

        <!-- Producers -->
        <mxCell id="prod0" value="&lt;b&gt;Producer 0&lt;/b&gt;&lt;br&gt;custom VHDL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="prod1" value="&lt;b&gt;Producer 1&lt;/b&gt;&lt;br&gt;custom VHDL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- Arbiter -->
        <mxCell id="arb" value="&lt;b&gt;block_arbiter&lt;/b&gt;&lt;br&gt;round-robin&lt;br&gt;NUM_PORTS producers&lt;br&gt;1 handshake = 1 block" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="300" y="140" width="160" height="160" as="geometry" />
        </mxCell>

        <!-- FIFO -->
        <mxCell id="fifo" value="&lt;b&gt;block_fifo&lt;/b&gt;&lt;br&gt;CoreFIFO BLOCK_FIFO_CORE&lt;br&gt;synchronous, FWFT&lt;br&gt;80 bit × 512 blocks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="540" y="180" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- Serializer -->
        <mxCell id="ser" value="&lt;b&gt;block_serializer&lt;/b&gt;&lt;br&gt;80 → 8 bit&lt;br&gt;bits 79:72 first&lt;br&gt;tlast on byte 9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="780" y="180" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- SPI master -->
        <mxCell id="spi" value="&lt;b&gt;axis_spi_wo_master&lt;/b&gt;&lt;br&gt;10-byte frames&lt;br&gt;MSB first" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1020" y="180" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- SPI pins -->
        <mxCell id="pins" value="SPI_SCLK&lt;br&gt;SPI_MOSI&lt;br&gt;SPI_CS_N" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.15;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1040" y="320" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- Connections -->
        <mxCell id="e_p0" value="80 b block&lt;br&gt;valid/ready" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.125;entryDx=0;entryDy=0;" edge="1" parent="1" source="prod0" target="arb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_p1" value="80 b block&lt;br&gt;valid/ready" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.875;entryDx=0;entryDy=0;" edge="1" parent="1" source="prod1" target="arb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_arb_fifo" value="80 b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="arb" target="fifo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_fifo_ser" value="80 b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="fifo" target="ser">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_ser_spi" value="AXI4-Stream&lt;br&gt;8 b + tlast" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ser" target="spi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_spi_pins" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="spi" target="pins">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="leg_done" value="exists" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="420" width="90" height="30" as="geometry" />
        </mxCell>
        <mxCell id="leg_todo" value="planned" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="420" width="90" height="30" as="geometry" />
        </mxCell>
        <mxCell id="leg_ext" value="not designed yet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="500" y="420" width="110" height="30" as="geometry" />
        </mxCell>
        <mxCell id="note" value="A block is 10 bytes. Bit 79 is sent first. Every transfer between producer, arbiter and FIFO carries a complete block, so blocks from different producers can never interleave. When the FIFO is full, ready goes low and producers wait (backpressure continues into upstream FIFOs, to be added)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="410" width="540" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
