documentation/*.pdf filter=lfs diff=lfs merge=lfs -text
# Libero Tcl and shell scripts: LF on every platform (CRLF breaks "\" line
# continuations in sh and makes export_components.tcl output differ per OS).
*.tcl text eol=lf
*.sh  text eol=lf
# cmd.exe needs CRLF for reliable labels/blocks.
*.bat text eol=crlf
