# PolarFire SoC Discovery Kit: on-board FT4232H, which enumerates as 1514:2008 (Embedded FlashPro5).
#
# By default ftdi_sio binds only interface 2. These rules:
#   1. add 1514:2008 to ftdi_sio so all four interfaces get a ttyUSB,
#   2. unbind interface 0 again, because that's JTAG (Libero / OpenOCD),
#   3. create stable names for the UARTs (schematic sheets 7 and 10):
#      /dev/pfsoc-uart1  interface 1 (channel B = MSS MMUART1, HSS console)
#      /dev/pfsoc-uart4  interface 2 (channel C = MSS MMUART4, HSS U54_1)
#      /dev/pfsoc-uart0  interface 3 (channel D = MSS MMUART0 via fabric, application console)
#
# Install:
#   sudo cp tools/99-pfsoc-discovery-uart.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
# then replug the board's USB cable.

# 1. Teach ftdi_sio the ID. new_id fails with EEXIST once it's been added, so ignore errors.
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="1514", ATTR{idProduct}=="2008", \
  RUN+="/sbin/modprobe ftdi_sio", \
  RUN+="/bin/sh -c 'echo 1514 2008 > /sys/bus/usb-serial/drivers/ftdi_sio/new_id 2>/dev/null || true'"

# 2. Release interface 0 (JTAG) as soon as ftdi_sio binds it.
ACTION=="bind", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_interface", DRIVER=="ftdi_sio", \
  ATTR{bInterfaceNumber}=="00", ATTRS{idVendor}=="1514", ATTRS{idProduct}=="2008", \
  RUN+="/bin/sh -c 'echo %k > /sys/bus/usb/drivers/ftdi_sio/unbind'"

# 3. Stable names for the UARTs. All ATTRS{} keys of a rule must match on the same sysfs device,
#    and bInterfaceNumber (interface) and idVendor (device) are on different ones, so match the
#    ID_* properties from the usb_id builtin instead. ACTION!="remove" so udevadm trigger works too.
ACTION!="remove", SUBSYSTEM=="tty", ENV{ID_VENDOR_ID}=="1514", ENV{ID_MODEL_ID}=="2008", ENV{ID_USB_INTERFACE_NUM}=="01", \
  SYMLINK+="pfsoc-uart1", GROUP="dialout", MODE="0660"
ACTION!="remove", SUBSYSTEM=="tty", ENV{ID_VENDOR_ID}=="1514", ENV{ID_MODEL_ID}=="2008", ENV{ID_USB_INTERFACE_NUM}=="02", \
  SYMLINK+="pfsoc-uart4", GROUP="dialout", MODE="0660"
ACTION!="remove", SUBSYSTEM=="tty", ENV{ID_VENDOR_ID}=="1514", ENV{ID_MODEL_ID}=="2008", ENV{ID_USB_INTERFACE_NUM}=="03", \
  SYMLINK+="pfsoc-uart0", GROUP="dialout", MODE="0660"
